# Generated by XcodeGen from project.yml -- regenerate with `xcodegen generate`
*.xcodeproj/

# Build products
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/

.DS_Store

# User-provided source recordings (126 MB). Tools/README.md documents how the
# PNG fixtures in Packages/GlyphRecognition/Tests/.../Fixtures/Assets/Screenshots/Recording are
# derived from them.
/ScreenRecording_*.MP4

# Game screenshots and crops the tests read. They are frames of the game's own
# screen, so they are not distributed with this source: they live in the
# private submodule at .../Fixtures/Assets (not affected by these rules),
# and these rules keep stray copies out of this repository. See the fixtures'
# PROVENANCE.md.
Packages/GlyphRecognition/Tests/GlyphRecognitionTests/Fixtures/**/*.png
Packages/GlyphRecognition/Tests/GlyphRecognitionTests/Fixtures/**/*.jpg
# ...except inside the submodule (git never applies these rules there anyway;
# this keeps copy and upload tools that read .gitignore from dropping them).
!Packages/GlyphRecognition/Tests/GlyphRecognitionTests/Fixtures/Assets/**
Apps/DynamicGlyph/Tests/DynamicGlyphTests/Fixtures/*.png
Tools/RecordingResults/*/*.jpg

# Raw device evidence pulled off the phone. These are screen captures of a real
# session -- they contain the tester's location, portal names and status bar --
# and they are large. Reports derived from them live in Tools/*Results/.
/spikeB-*/

# Icon working files; the app icon itself is in the asset catalogue.
/ICON.png
/Icon/

# Third-party reference tables. They carry no licence and are not ours to
# redistribute -- see the fixtures' PROVENANCE.md. Keep your own copy here and
# the full test suite runs; without it the table-dependent tests skip.
Packages/GlyphRecognition/Tests/GlyphRecognitionTests/Fixtures/glyph.csv
Packages/GlyphRecognition/Tests/GlyphRecognitionTests/Fixtures/glyph_line.csv

# Per-machine build values. Config/Build.xcconfig includes both optionally, so
# a clone with neither still generates and builds: Local.xcconfig is your own
# signing identity, CI.xcconfig is written by the Xcode Cloud post-clone script.
/Config/Local.xcconfig
/Config/CI.xcconfig

# Local copy-paste sheet for App Store Connect's TestFlight form; personal
# contact details get filled in here.
/TESTFLIGHT_SUBMISSION.md

# Local build-service settings.
/.airbuild/
