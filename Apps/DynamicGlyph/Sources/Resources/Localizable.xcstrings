    "Hiding playback controls isn't available on this version of iOS." : {
      "comment" : "Settings footer under 'Hide playback controls'.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このバージョンの iOS では再生コントロールを隠せません。"
          }
        },
