          }
        }
      }
    },
    "Your iCloud storage is full, so results aren't syncing. They're kept on this iPhone. Free up space or upgrade in Settings > your name > iCloud; results sync once there's room." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud のストレージがいっぱいのため、結果は同期されていません。結果はこの iPhone に保存されています。「設定」>「ユーザ名」>「iCloud」で空き容量を増やすかアップグレードしてください。空きができると同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 iCloud 储存空间已满，因此结果未同步。结果会保留在此 iPhone 上。请在“设置”>“你的姓名”>“iCloud”中释放空间或升级；有空间后结果就会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 iCloud 儲存空間已滿，因此結果未同步。結果會保留在此 iPhone 上。請在「設定」>「你的名稱」>「iCloud」中釋放空間或升級；有空間後結果就會同步。"
          }
        }
      }
    },
