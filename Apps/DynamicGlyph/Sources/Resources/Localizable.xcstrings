    "Shows that a copy of the file wasn't changed on the way. It doesn't prove what the game showed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ファイルのコピーが途中で変更されていないことを示します。ゲームの表示内容を証明するものではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用于确认文件副本在传输过程中未被更改，并不能证明游戏实际显示的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用於確認檔案副本在傳輸過程中未被更改，並不能證明遊戲實際顯示的內容。"
          }
        }
