          }
        }
      }
    },
    "Live Activities are off, so the Dynamic Island can't show drops yet. The floating window stays on until they are." : {
      "comment" : "Setup, floating window page, reading gear only: the Island was chosen but Live Activities are off.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ライブアクティビティがオフのため、Dynamic Islandにはまだドロップを表示できません。オンになるまで、フローティングウインドウは表示されたままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "实时活动已关闭，灵动岛暂时无法显示掉落。在实时活动打开之前，悬浮窗会一直保持显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
