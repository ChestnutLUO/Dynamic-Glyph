    },
    "Follows each Glyph hack and shows its sequence while you draw, using your Glyph list." : {
      "comment" : "Settings footer: Glyph assistance on. Shown only once a Glyph list is loaded.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
