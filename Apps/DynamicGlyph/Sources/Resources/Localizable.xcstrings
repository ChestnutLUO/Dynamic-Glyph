          }
        }
      }
    },
    "Your bug-report recording is nearing its size limit. It will stop automatically at 300 MB. Glyph recognition will continue." : {
      "comment" : "Recording warning at 90 percent of the bug-report video's size limit.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
