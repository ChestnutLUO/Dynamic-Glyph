    "Opens Dynamic Glyph to start reading the screen. You confirm screen sharing each time." : {
      "comment" : "Shortcuts: what Start Dynamic Glyph does.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Glyphを開いて画面の読み取りを始めます。毎回、画面共有の確認が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
