    "Deleting a hack result also deletes its gear reading, and statistics change to match." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ハック結果を削除すると、そのアイテムの読み取りも削除され、統計もそれに合わせて変わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "删除 Hack 结果也会删除其装备读取结果，统计数据也会随之改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
