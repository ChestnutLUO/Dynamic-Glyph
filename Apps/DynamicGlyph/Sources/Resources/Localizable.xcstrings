    "Only what the app read is here: hacks and drops it didn't see, or read no items from, aren't counted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ここにあるのはアプリが読み取ったものだけです。アプリが見ていない、またはアイテムを読み取れなかったハックやドロップは数えられていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这里只有应用读取到的内容：应用没有看到、或没有读取到任何物品的 Hack 和掉落不计算在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這裡只有 App 讀取到的內容：App 沒有看到、或沒有讀取到任何物品的 Hack 和掉落不計算在內。"
