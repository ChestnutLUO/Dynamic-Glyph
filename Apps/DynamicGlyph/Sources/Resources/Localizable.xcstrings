    },
    "Command" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コマンド"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指令"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指令"
          }
        }
      }
    },
    "Commands are read from the game's notices before each hack. None means no notice was seen; uncertain means one may have been missed. Gear per hack counts only hacks whose items were read in full with no multiplied drop, shown as measured of all. Drone hacks can't get keys, so they're kept apart." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コマンドは各ハックの前にゲームの通知から読み取ります。「なし」は通知が見えなかったこと、「不明」は見逃した可能性があることを示します。1 回あたりのアイテム数は、アイテムを完全に読み取れ、倍増ドロップのないハックのみを数え、全体のうち計測した数として示します。ドローンのハックはキーを得られないため、別に表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指令是在每次 Hack 前从游戏的提示中读取的。“无”表示没有看到提示，“不确定”表示可能漏看了提示。每次物品数只统计物品完整读取且没有加倍掉落的 Hack，并显示为计入数/总数。无人机 Hack 无法获得钥匙，因此单独列出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指令是在每次 Hack 前從遊戲的提示中讀取的。「無」表示沒有看到提示，「不確定」表示可能漏看了提示。每次物品數只統計物品完整讀取且沒有加倍掉落的 Hack，並顯示為計入數/總數。無人機 Hack 無法獲得鑰匙，因此單獨列出。"
          }
        }
      }
    },
