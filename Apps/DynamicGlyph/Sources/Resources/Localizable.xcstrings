    "Report a problem or ask a question. For a problem with recognition, share a report from Session logs and reports along with your message." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不具合の報告や質問はこちらから。認識の問題の場合は、「セッションのログとレポート」からレポートを共有してメッセージに添えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "报告问题或提出疑问。如果是识别问题，请从“会话日志与报告”分享一份报告，并附在消息中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
